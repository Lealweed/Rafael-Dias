              "type": "boolean",
              "value": true
            },
            {
              "id": "reason",
              "name": "reason",
              "type": "string",
              "value": "paused_human"
            },
            {
              "id": "message",
              "name": "message",
              "type": "string",
              "value": "Atendimento humano ativo. Fluxo do agente interrompido."
            }
          ]
        },
        "options": {}
      },
      "id": "BuildPausedResponse",
      "name": "Build Paused Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1280, 180]
    },
    {
      "parameters": {
        "assignments": {
