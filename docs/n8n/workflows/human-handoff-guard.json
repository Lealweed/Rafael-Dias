              "type": "string",
              "value": "={{ $json.body?.contactId || $json.contactId || '' }}"
            },
            {
              "id": "destination",
              "name": "destination",
              "type": "string",
              "value": "={{ (($json.body?.destination || $json.destination || $json.body?.phone || $json.phone || $json.body?.from || $json.from || '').toString()).split('@')[0].replace(/\\D/g, '') }}"
            },
            {
              "id": "incomingMessage",
              "name": "incomingMessage",
              "type": "string",
              "value": "={{ $json.body?.message || $json.message || $json.body?.text || $json.text || '' }}"
            },
            {
              "id": "replyText",
              "name": "replyText",
              "type": "string",
              "value": "={{ $json.body?.replyText || $json.replyText || 'Mensagem automatica de teste.' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "NormalizeInput",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 300]
