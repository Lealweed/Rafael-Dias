            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.lead?.automation_status || '' }}",
              "rightValue": "paused_human",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "IsPausedHuman",
